{
  "redirects": [
    {
      "source": "/download",
      "destination": "https://raw.githubusercontent.com/qasimtechlab/nexa-tv-launcher/main/releases/NEXA-TV-Launcher-latest.apk",
      "permanent": false
    },
    {
      "source": "/latest.apk",
      "destination": "https://raw.githubusercontent.com/qasimtechlab/nexa-tv-launcher/main/releases/NEXA-TV-Launcher-latest.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/release.json",
      "destination": "https://raw.githubusercontent.com/qasimtechlab/nexa-tv-launcher/main/releases/latest.json"
    }
  ],
  "headers": [
    {
      "source": "/release.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
